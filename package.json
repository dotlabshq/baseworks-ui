{
  "name": "@baseworks/ui",
  "version": "0.1.0",
  "description": "The baseworks design system: tokens, primitives and the application frame. Plain CSS and React, no utility framework.",
  "type": "module",
  "publishConfig": { "access": "public" },
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./tokens.css": "./src/tokens.css",
    "./primitives.css": "./src/primitives.css",
    "./frame.css": "./src/frame.css"
  },
  "files": ["src"],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@baseworks/tsconfig": "workspace:*",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.9.3"
  }
}
